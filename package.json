{
  "name": "trainers-point",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "npm run build && node --test tests/*.test.cjs web/calendar-core.test.cjs",
    "db:calendar": "npm run build && node scripts/setup-calendar.cjs",
    "dev:calendar": "npm run build && node scripts/dev-calendar.cjs"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "jsdom": "^27.0.1",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "nodemon": {
      "chokidar": "^4.0.3"
    }
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22"
  }
}
