{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "OPTIONAL Trainers Point HTTP API proxy. Review costs and authorization before creating a stack.",
  "Parameters": {
    "BackendOrigin": {
      "Type": "String",
      "Description": "Existing public HTTPS backend origin, without a trailing slash. Never localhost.",
      "AllowedPattern": "https://[a-zA-Z0-9.-]+"
    }
  },
  "Resources": {
    "Api": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": { "Name": "trainers-point-api", "ProtocolType": "HTTP", "DisableExecuteApiEndpoint": false }
    },
    "BackendIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": { "Ref": "Api" },
        "IntegrationType": "HTTP_PROXY",
        "IntegrationMethod": "ANY",
        "IntegrationUri": { "Fn::Sub": "${BackendOrigin}/api/{proxy}" },
        "PayloadFormatVersion": "1.0",
        "TimeoutInMillis": 15000
      }
    },
    "ApiRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": { "Ref": "Api" },
        "RouteKey": "ANY /api/{proxy+}",
        "AuthorizationType": "NONE",
        "Target": { "Fn::Join": ["/", ["integrations", { "Ref": "BackendIntegration" }]] }
      }
    },
    "Stage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Properties": {
        "ApiId": { "Ref": "Api" },
        "StageName": "$default",
        "AutoDeploy": true,
        "DefaultRouteSettings": { "ThrottlingBurstLimit": 40, "ThrottlingRateLimit": 20 }
      }
    }
  },
  "Outputs": {
    "ApiOrigin": {
      "Description": "Set EXPO_PUBLIC_API_URL to this origin for native clients; browser clients still need a same-origin /api proxy.",
      "Value": { "Fn::GetAtt": ["Api", "ApiEndpoint"] }
    }
  }
}
