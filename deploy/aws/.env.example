# Plantilla sin activar recursos ni modificar la base local. Nunca guardar secretos en Git.
PUBLIC_ORIGIN=https://tu-dominio.example
CALENDAR_ADMIN_TOKEN=REEMPLAZAR_POR_UN_SECRETO_DE_AL_MENOS_32_CARACTERES
# URL de una instancia PostgreSQL existente. Codificar los caracteres reservados de la contraseña.
# sslcert es una ruta ABSOLUTA dentro del contenedor; Prisma CLI también necesita ver el CA.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@INSTANCIA.REGION.rds.amazonaws.com:5432/trainers_point?schema=public&sslmode=require&sslaccept=strict&sslcert=/run/certs/rds-ca-bundle.pem
DATABASE_SSL_CA_FILE=/run/certs/rds-ca-bundle.pem
# Ruta en el ordenador/servidor al CA oficial de RDS; se monta en modo lectura.
RDS_CA_HOST_FILE=/ruta/real/rds-ca-bundle.pem
COGNITO_ENABLED=false
# COGNITO_USER_POOL_ID=eu-south-2_REEMPLAZAR
# COGNITO_CLIENT_ID=REEMPLAZAR
REMINDERS_ENABLED=false
REMINDERS_ALLOW_SEND=false
