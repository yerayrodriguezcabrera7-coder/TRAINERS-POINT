# Usa una contraseña hexadecimal aleatoria para evitar caracteres reservados en la URL.
DATABASE_PASSWORD=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO
CALENDAR_ADMIN_TOKEN=REEMPLAZAR_POR_OTRO_SECRETO_DE_AL_MENOS_32_CARACTERES
PUBLIC_ORIGIN=https://tu-dominio.example

# Opcional, tras disponer de recursos AWS y cuentas vinculadas. Ver deploy/aws/README.md.
COGNITO_ENABLED=false
