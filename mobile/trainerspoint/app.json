{
  "expo": {
    "name": "Trainers Point",
    "slug": "trainerspoint",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trainerspoint.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Tu ubicación se usa al fichar para verificar que estás en el centro."
      }
    },
    "android": {
      "package": "com.trainerspoint.app"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tu ubicación se usa al fichar para verificar que estás en el centro."
        }
      ],
      ["expo-audio", { "recordAudioAndroid": false, "enableBackgroundPlayback": false }],
      ["expo-notifications", { "enableBackgroundRemoteNotifications": false }]
    ],
    "web": {
      "bundler": "metro"
    }
  }
}
