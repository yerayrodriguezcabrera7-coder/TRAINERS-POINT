# `npm run dev` configura las credenciales locales persistentes en `.calendar-dev/`.
DATABASE_URL="postgresql://postgres:local@127.0.0.1:55439/postgres?schema=public&sslmode=disable"

# Puerto local de PostgreSQL.
# CALENDAR_DEV_DB_PORT=55439
# Identificador interno del centro del calendario.
# CALENDAR_GYM=cobosu-bizkaia
# Puerto único de la aplicación (por defecto 3000).
# PORT=3000

# AWS opcional: no se crea ni contrata ningún recurso con esta configuración.
COGNITO_ENABLED=false
# COGNITO_USER_POOL_ID=eu-south-2_REEMPLAZAR
# COGNITO_CLIENT_ID=REEMPLAZAR
# Para RDS: archivo local/montado con el certificado CA oficial de AWS.
# DATABASE_SSL_CA_FILE=/run/certs/rds-ca-bundle.pem

# Recordatorios: desactivados. Activar solo tras contratar/configurar el proveedor.
REMINDERS_ENABLED=false
REMINDERS_ALLOW_SEND=false
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+...
# TWILIO_WHATSAPP_FROM=+...
# Plantilla aprobada: 1 cliente, 2 fecha, 3 hora, 4 servicio, 5 entrenador.
# TWILIO_WHATSAPP_CONTENT_SID=
# Plantilla aprobada para recordatorio detallado: 1 cliente, 2 fecha, 3 hora, 4 servicio, 5 entrenador, 6 bono/recuperación y 7 política de cancelación.
# TWILIO_WHATSAPP_REMINDER_CONTENT_SID=
# Email reminders (SendGrid; optional if email is not a selected channel)
# SENDGRID_API_KEY=
# REMINDER_EMAIL_FROM=
# Separate approved WhatsApp template for the weekly schedule (needs variables 1 client, 2 start date, 3 end date, 4 agenda, 5 centre)
# TWILIO_WHATSAPP_WEEKLY_CONTENT_SID=
