# `npm run dev` configura las credenciales locales persistentes en `.calendar-dev/`.
DATABASE_URL="postgresql://postgres:local@127.0.0.1:55439/postgres?schema=public&sslmode=disable"

# Puerto local de PostgreSQL.
# CALENDAR_DEV_DB_PORT=55439
# Identificador interno del centro del calendario.
# CALENDAR_GYM=cobosu-bizkaia
# Puerto único de la aplicación (por defecto 3000).
# PORT=3000

# Recordatorios: desactivados. Activar solo tras contratar/configurar el proveedor.
REMINDERS_ENABLED=false
REMINDERS_ALLOW_SEND=false
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+...
# TWILIO_WHATSAPP_FROM=+...
# Plantilla aprobada: 1 cliente, 2 fecha, 3 hora, 4 servicio, 5 entrenador.
# TWILIO_WHATSAPP_CONTENT_SID=
