# Copia este archivo a .env y sustituye la contraseña por la credencial de RDS.
# Codifica como percent-encoding los caracteres reservados de la contraseña.
DATABASE_URL="postgresql://postgres:CAMBIA_ESTA_PASSWORD@trainerspoint-db.cg7eogw40qp5.us-east-1.rds.amazonaws.com:5432/postgres?schema=public&sslmode=require"

# --- Opcionales (aplicación integrada) ---
# Puerto único de la aplicación (por defecto 3000).
# PORT=3000
# El calendario usa su propio PostgreSQL local aislado (carpeta .calendar-dev), NO DATABASE_URL.
# CALENDAR_DEV_DB_PORT=55439
# Identificador interno del centro del calendario (por defecto cobosu-bizkaia; no es visible).
# CALENDAR_GYM=cobosu-bizkaia
