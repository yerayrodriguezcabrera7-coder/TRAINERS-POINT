# PostgreSQL propio del proyecto (solo para npm run db:calendar / npm start)
DATABASE_URL=postgresql://usuario:password@localhost:5432/trainers_point
CALENDAR_GYM=cobosu-bizkaia
# Genera una clave aleatoria de 24 caracteres o más; nunca la subas a Git.
CALENDAR_ADMIN_TOKEN=
PORT=3000
# npm run dev:calendar usa PostgreSQL local aislado, no DATABASE_URL.
CALENDAR_DEV_DB_PORT=55439
